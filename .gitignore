# =============================================================================
#  Gone_Golfing / Ostrich Effect --- .gitignore
# =============================================================================
#  POLICY
#    Track:   all code, all lockfiles, small irreplaceable source inputs,
#             pooled results, provenance records, manuscript source.
#    Exclude: bulk regenerable outputs, multi-GB source archives, build
#             artifacts, credentials.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. CREDENTIALS AND SECRETS  (never track, no exceptions)
# -----------------------------------------------------------------------------
.env
.env.*
*.key
*.pem
*credentials*
*secret*
settings.local.json
.claude


# -----------------------------------------------------------------------------
# 2. OS AND EDITOR ARTIFACTS
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*~
*.swp


# -----------------------------------------------------------------------------
# 3. LANGUAGE ENVIRONMENTS
# -----------------------------------------------------------------------------

# --- R ---
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj
renv/library/
renv/staging/
renv/local/
renv/cellar/
renv/sandbox/
!renv.lock
!renv/activate.R
!renv/settings.json

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
!requirements.txt

# --- Julia ---
!Project.toml
!Manifest.toml


# -----------------------------------------------------------------------------
# 4. LATEX BUILD ARTIFACTS
# -----------------------------------------------------------------------------
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.bbl-SAVE-ERROR
*.bcf-SAVE-ERROR
*.xml


# -----------------------------------------------------------------------------
# 5. LARGE SOURCE ARCHIVES  (excluded by size; hashes in DATA_PROVENANCE.md)
# -----------------------------------------------------------------------------
*.pbf
*.osm
*.zip
*.7z
*.tar.gz
*.gz


# -----------------------------------------------------------------------------
# 6. GEOSPATIAL BINARIES
# -----------------------------------------------------------------------------
*.gpkg
*.gpkg-shm
*.gpkg-wal
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.sbn
*.sbx

# --- exception: cb_20m county/state boundaries are tracked COMPLETE (all
#     sidecars). They document the superseded configuration in Appendix A.1.1.
#     A shapefile is tracked as a set or not at all. ---
!2 - Work/00 - Data Sources/Original Data/cb_2022_us_county_20m.*
!2 - Work/00 - Data Sources/Original Data/cb_2022_us_state_20m/cb_2022_us_state_20m.*

# -----------------------------------------------------------------------------
# 7. TABULAR DATA  --- exclude bulk, admit sources and results
# -----------------------------------------------------------------------------
*.csv
*.tsv

# --- never track: regenerable bulk ---
*_Imputed_Dataset_*.csv

# --- source inputs (small, irreplaceable) ---
!2 - Work/00 - Data Sources/**/*.csv

# --- pooled results and diagnostics ---
!**/*_Rubins_Rules_Summary*.csv
!**/*_National_Acreage_Summary*.csv
!**/Phase5_Oahu_Comparison*.csv
!**/R_Assessment_By_Class.csv

# --- provenance and hand-verified crosswalks ---
!**/Run_Provenance_*.csvg
!**/Oahu_Course_Polygon_Crosswalk.csv
!**/Assessment_Retrieval_Targets.csv
!**/Assessment_Retrieval_Worksheet.csv
!**/Assessment_Retrieval_Comparison.csv
!**/MANIFEST.csv

# --- but NOT the large re-obtainable extracts (record in DATA_PROVENANCE.md) ---
2 - Work/00 - Data Sources/Honolulu/All_Parcels_*.csv
2 - Work/00 - Data Sources/Honolulu/Cadastral_*.csv
2 - Work/00 - Data Sources/**/hpi_master.csv
2 - Work/00 - Data Sources/**/*HPI Master.csv


# -----------------------------------------------------------------------------
# 8. FIGURES
# -----------------------------------------------------------------------------
*.png
*.jpg
*.jpeg
*.tif
*.tiff
!**/Final_Thesis_Figures/*.png


# -----------------------------------------------------------------------------
# 9. ARCHIVES AND SCRATCH
# -----------------------------------------------------------------------------
2 - Work/00 - Pre-P309 Outputs*/
**/Data_stale_*/
Junk Information/
extra junk/
999 - Late Stage/
_P520_TEST/
_ENV_TEST/


# -----------------------------------------------------------------------------
# 10. COPYRIGHTED READING MATERIAL  (not redistributable)
# -----------------------------------------------------------------------------
**/1 - Readings/**